ENV="development"   # development or production
NODE_ENV="${ENV}"

VITE_GOOGLE_CLIENT_ID="random-string.apps.googleusercontent.com" # Get your google client Id from Google Cloud Console
VITE_GOOGLE_SITE_VERIFICATION="site-verification-meta-content" # Only for production

VITE_API_URL="http://localhost:4000"   # backend url
VITE_SITE_URL="http://localhost:5173"  # frontend url

PORT="5173" # port for preview (development)