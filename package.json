{
  "name": "bun-react-router-boilerplate",
  "version": "1.0.0",
  "private": false,
  "description": "Frontend Boilerplate for personal use",
  "type": "module",
  "scripts": {
    "build:dev": "dotenv -e .env.development -- node scripts/generate-sitemap.js && react-router build",
    "build:prod": "dotenv -e .env.production -- node scripts/generate-sitemap.js && react-router build",
    "build:test": "node scripts/generate-sitemap.js && react-router build",
    "dev": "dotenv -e .env.development -- react-router dev",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "preview:dev": "dotenv -e .env.development -- react-router-serve ./build/server/index.js",
    "preview:prod": "dotenv -e .env.production -- react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@forge42/seo-tools": "^1.4.5",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.23",
    "@react-router/node": "7.10.1",
    "@react-router/serve": "7.10.1",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "isbot": "^5.1.31",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-photo-view": "^1.2.7",
    "react-router": "7.10.1",
    "remark-breaks": "^4.0.0",
    "remix-hook-form": "^7.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "terser": "^5.44.1",
    "ts-pattern": "^5.9.0",
    "valibot": "^1.2.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@react-router/dev": "7.10.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.5",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4.3.3",
    "tsc-files": "^1.1.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-tsconfig-paths": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
